# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/tedmark

# ── AI ────────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# ── Lead discovery ────────────────────────────────────────────────────────────
GEOAPIFY_API_KEY=
BRAVE_API_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Tedmark Digital <hello@tedmarkdigital.com>
IMAP_HOST=
IMAP_USER=
IMAP_PASS=

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=        # any secret string — must match what you set in Meta dashboard
WHATSAPP_TOKEN=               # EAAxxxxxxx — Meta Cloud API access token
WHATSAPP_PHONE_NUMBER_ID=     # from Meta dashboard → WhatsApp → API Setup
WHATSAPP_OWNER_PHONE=         # your personal WhatsApp in E.164, no +: e.g. 233244123456

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Deployment ────────────────────────────────────────────────────────────────
# On Render (agents server):
PORT=4000

# On Vercel (web app) — point to Render service URL:
RENDER_API_URL=https://tedmark-agents.onrender.com
RENDER_API_SECRET=            # any strong secret — must match RENDER_API_SECRET on Render

# ── Web app auth ──────────────────────────────────────────────────────────────
AUTH_SECRET=                  # random 32+ char string
